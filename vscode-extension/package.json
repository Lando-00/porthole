{
  "name": "porthole-companion",
  "displayName": "porthole companion",
  "description": "Lets the porthole Copilot CLI plugin reveal and highlight ranges in this window.",
  "version": "0.3.0",
  "publisher": "Lando-00",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lando-00/porthole"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "copilot",
    "cli",
    "porthole",
    "highlight"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "npx --yes @vscode/vsce package --allow-missing-repository --skip-license -o porthole-companion.vsix",
    "install-local": "npm run package && code-insiders --install-extension porthole-companion.vsix --force"
  },
  "contributes": {
    "commands": [
      {
        "command": "porthole.clearHighlight",
        "title": "porthole: Clear highlight"
      },
      {
        "command": "porthole.clearAnnotations",
        "title": "porthole: Clear annotations"
      },
      {
        "command": "porthole.nextAnnotation",
        "title": "porthole: Next annotation"
      },
      {
        "command": "porthole.previousAnnotation",
        "title": "porthole: Previous annotation"
      },
      {
        "command": "porthole.listAnnotations",
        "title": "porthole: List annotations"
      },
      {
        "command": "porthole.showUriExample",
        "title": "porthole: Show reveal URI for the current selection"
      },
      {
        "command": "porthole.refresh",
        "title": "porthole: Refresh session and tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "porthole.tour.next",
        "title": "porthole: Next tour step"
      },
      {
        "command": "porthole.tour.previous",
        "title": "porthole: Previous tour step"
      },
      {
        "command": "porthole.tour.goto",
        "title": "porthole: Go to tour step"
      },
      {
        "command": "porthole.tour.list",
        "title": "porthole: List tour steps"
      },
      {
        "command": "porthole.tour.exit",
        "title": "porthole: Exit tour"
      },
      {
        "command": "porthole.saveReview",
        "title": "porthole: Save review"
      },
      {
        "command": "porthole.loadReview",
        "title": "porthole: Load review"
      },
      {
        "command": "porthole.sendToCopilot",
        "title": "porthole: Send selection to Copilot",
        "icon": "$(comment-discussion)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "porthole",
          "title": "porthole",
          "icon": "media/porthole.svg"
        }
      ]
    },
    "views": {
      "porthole": [
        {
          "id": "porthole.session",
          "name": "Session"
        },
        {
          "id": "porthole.tasks",
          "name": "Tasks"
        },
        {
          "id": "porthole.tour",
          "name": "Tour"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "porthole.session",
        "contents": "No active Copilot CLI session was found.\n\nRun [/cops](command:porthole.refresh) in Copilot CLI to open this project and its session folder in one workspace, then refresh.\n[Refresh](command:porthole.refresh)"
      },
      {
        "view": "porthole.tasks",
        "contents": "No active Copilot CLI session was found.\n[Refresh](command:porthole.refresh)"
      }
    ],
    "configuration": {
      "title": "porthole companion",
      "properties": {
        "porthole.highlight.style": {
          "type": "string",
          "enum": [
            "selection",
            "flash",
            "both"
          ],
          "default": "both",
          "description": "How a revealed range is shown: as a real editor selection, a temporary flash decoration, or both."
        },
        "porthole.highlight.flashDurationMs": {
          "type": "number",
          "default": 2500,
          "minimum": 0,
          "description": "How long the flash decoration stays visible. 0 keeps it until cleared."
        },
        "porthole.diagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Write a diagnostics log to the temp folder (porthole-companion.log). Only needed when a porthole command appears to do nothing."
        },
        "porthole.annotations.gutterIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show a gutter icon next to each annotated range."
        },
        "porthole.annotations.autoRevealFocus": {
          "type": "boolean",
          "default": true,
          "description": "Open and scroll to the focused annotation when a new set arrives."
        }
      }
    },
    "keybindings": [
      {
        "command": "porthole.tour.next",
        "key": "alt+]",
        "when": "porthole.tourActive"
      },
      {
        "command": "porthole.tour.previous",
        "key": "alt+[",
        "when": "porthole.tourActive"
      },
      {
        "command": "porthole.tour.exit",
        "key": "alt+escape",
        "when": "porthole.tourActive"
      },
      {
        "command": "porthole.sendToCopilot",
        "key": "ctrl+alt+.",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "porthole.tour.goto",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "porthole.sendToCopilot",
          "group": "porthole@1",
          "when": "editorTextFocus"
        }
      ],
      "view/title": [
        {
          "command": "porthole.refresh",
          "when": "view == porthole.session || view == porthole.tasks",
          "group": "navigation"
        },
        {
          "command": "porthole.tour.exit",
          "when": "view == porthole.tour && porthole.tourActive",
          "group": "navigation"
        }
      ]
    }
  }
}
