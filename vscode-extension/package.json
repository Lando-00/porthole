{
  "name": "porthole-companion",
  "displayName": "porthole companion",
  "description": "The editor half of porthole: lets Copilot CLI reveal ranges, annotate code, run narrated walkthroughs, read your Problems panel, and take a selection back into the session.",
  "version": "0.4.1",
  "publisher": "Lando-00",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#18202C",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lando-00/porthole.git"
  },
  "bugs": {
    "url": "https://github.com/Lando-00/porthole/issues"
  },
  "homepage": "https://github.com/Lando-00/porthole#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Education"
  ],
  "keywords": [
    "copilot",
    "copilot cli",
    "porthole",
    "walkthrough",
    "code tour",
    "annotations",
    "highlight"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "icon": "pwsh -File scripts/make-icon.ps1",
    "package": "npx --yes @vscode/vsce package -o porthole-companion.vsix",
    "publish": "npx --yes @vscode/vsce publish",
    "install-local": "npm run package && code-insiders --install-extension porthole-companion.vsix --force"
  },
  "contributes": {
    "commands": [
      {
        "command": "porthole.clearHighlight",
        "title": "porthole: Clear highlight"
      },
      {
        "command": "porthole.clearAnnotations",
        "title": "porthole: Clear annotations"
      },
      {
        "command": "porthole.nextAnnotation",
        "title": "porthole: Next annotation"
      },
      {
        "command": "porthole.previousAnnotation",
        "title": "porthole: Previous annotation"
      },
      {
        "command": "porthole.listAnnotations",
        "title": "porthole: List annotations"
      },
      {
        "command": "porthole.showUriExample",
        "title": "porthole: Show reveal URI for the current selection"
      },
      {
        "command": "porthole.refresh",
        "title": "porthole: Refresh session and tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "porthole.tour.next",
        "title": "porthole: Next tour step"
      },
      {
        "command": "porthole.tour.previous",
        "title": "porthole: Previous tour step"
      },
      {
        "command": "porthole.tour.goto",
        "title": "porthole: Go to tour step"
      },
      {
        "command": "porthole.tour.list",
        "title": "porthole: List tour steps"
      },
      {
        "command": "porthole.tour.exit",
        "title": "porthole: Exit tour"
      },
      {
        "command": "porthole.tour.switch",
        "title": "porthole: Switch tour",
        "icon": "$(list-unordered)"
      },
      {
        "command": "porthole.tour.closeAll",
        "title": "porthole: Close all tours",
        "icon": "$(clear-all)"
      },
      {
        "command": "porthole.tour.activate",
        "title": "porthole: Walk this tour",
        "icon": "$(play)"
      },
      {
        "command": "porthole.tour.close",
        "title": "porthole: Stop walking this tour",
        "icon": "$(debug-stop)"
      },
      {
        "command": "porthole.tour.jump",
        "title": "porthole: Go to tour step"
      },
      {
        "command": "porthole.tour.delete",
        "title": "porthole: Delete tour",
        "icon": "$(trash)"
      },
      {
        "command": "porthole.saveReview",
        "title": "porthole: Save review"
      },
      {
        "command": "porthole.loadReview",
        "title": "porthole: Load review"
      },
      {
        "command": "porthole.sendToCopilot",
        "title": "porthole: Send selection to Copilot",
        "icon": "$(comment-discussion)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "porthole",
          "title": "porthole",
          "icon": "media/porthole.svg"
        }
      ]
    },
    "views": {
      "porthole": [
        {
          "id": "porthole.session",
          "name": "Session"
        },
        {
          "id": "porthole.tasks",
          "name": "Tasks"
        },
        {
          "id": "porthole.tour",
          "name": "Tours"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "porthole.session",
        "contents": "No active Copilot CLI session was found.\n\nRun [/cops](command:porthole.refresh) in Copilot CLI to open this project and its session folder in one workspace, then refresh.\n[Refresh](command:porthole.refresh)"
      },
      {
        "view": "porthole.tasks",
        "contents": "No active Copilot CLI session was found.\n[Refresh](command:porthole.refresh)"
      }
    ],
    "configuration": {
      "title": "porthole companion",
      "properties": {
        "porthole.highlight.style": {
          "type": "string",
          "enum": [
            "selection",
            "flash",
            "both"
          ],
          "default": "both",
          "description": "How a revealed range is shown: as a real editor selection, a temporary flash decoration, or both."
        },
        "porthole.highlight.flashDurationMs": {
          "type": "number",
          "default": 2500,
          "minimum": 0,
          "description": "How long the flash decoration stays visible. 0 keeps it until cleared."
        },
        "porthole.diagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Write a diagnostics log to the temp folder (porthole-companion.log). Only needed when a porthole command appears to do nothing."
        },
        "porthole.problems.publish": {
          "type": "boolean",
          "default": true,
          "description": "Show porthole annotations and tour steps in the Problems panel. Each one is marked on its first line only. Turn this off to read your code without any underline; the gutter icons, highlights and CodeLenses stay either way."
        },
        "porthole.annotations.gutterIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show a gutter icon next to each annotated range."
        },
        "porthole.annotations.autoRevealFocus": {
          "type": "boolean",
          "default": true,
          "description": "Open and scroll to the focused annotation when a new set arrives."
        }
      }
    },
    "keybindings": [
      {
        "command": "porthole.tour.next",
        "key": "alt+]",
        "when": "porthole.tourActive"
      },
      {
        "command": "porthole.tour.previous",
        "key": "alt+[",
        "when": "porthole.tourActive"
      },
      {
        "command": "porthole.tour.exit",
        "key": "alt+escape",
        "when": "porthole.tourActive"
      },
      {
        "command": "porthole.sendToCopilot",
        "key": "ctrl+alt+.",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "porthole.tour.goto",
          "when": "false"
        },
        {
          "command": "porthole.tour.jump",
          "when": "false"
        },
        {
          "command": "porthole.tour.activate",
          "when": "porthole.tourLibrary"
        },
        {
          "command": "porthole.tour.close",
          "when": "porthole.tourActive"
        },
        {
          "command": "porthole.tour.delete",
          "when": "porthole.tourLibrary"
        },
        {
          "command": "porthole.tour.switch",
          "when": "porthole.tourLibrary"
        },
        {
          "command": "porthole.tour.closeAll",
          "when": "porthole.tourLibrary"
        }
      ],
      "editor/context": [
        {
          "command": "porthole.sendToCopilot",
          "group": "porthole@1",
          "when": "editorTextFocus"
        }
      ],
      "view/title": [
        {
          "command": "porthole.refresh",
          "when": "view == porthole.session || view == porthole.tasks",
          "group": "navigation"
        },
        {
          "command": "porthole.tour.switch",
          "when": "view == porthole.tour && porthole.tourLibrary",
          "group": "navigation@1"
        },
        {
          "command": "porthole.tour.exit",
          "when": "view == porthole.tour && porthole.tourActive",
          "group": "navigation@2"
        },
        {
          "command": "porthole.tour.closeAll",
          "when": "view == porthole.tour && porthole.tourLibrary",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "porthole.tour.activate",
          "when": "view == porthole.tour && viewItem == tourInactive",
          "group": "inline@1"
        },
        {
          "command": "porthole.tour.close",
          "when": "view == porthole.tour && viewItem == tourActive",
          "group": "inline@1"
        },
        {
          "command": "porthole.tour.delete",
          "when": "view == porthole.tour && viewItem =~ /^tour(Active|Inactive)$/",
          "group": "inline@2"
        }
      ]
    }
  }
}
